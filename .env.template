# PTMdiscoverer + ADEPT — cp .env.template .env and fill in your values.
#
# ── PTMdiscoverer standalone ────────────────────────────────────────────────
# Required for ptmdiscoverer-mcp and direct library use.
# Any OpenAI-compatible endpoint works (OpenAI, vLLM, Ollama, LiteLLM, …)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ── ADEPT agentic framework ──────────────────────────────────────────────────
# Primary LLM — OpenAI-compatible endpoint (takes precedence over OPENAI_API_KEY)
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_MODEL=gpt-4o
INTERNAL_LLM_EMBEDDING_MODEL=text-embedding-3-small

# Override model names (auto-derived in Docker; rarely needed)
# LANGCHAIN_LLM_MODEL=gpt-4o
# EMBEDDING_DEFAULT_MODEL=text-embedding-3-small
# DEFAULT_LLM_MODEL=gpt-4o

# MCP Server URL (set automatically in Docker; override for local dev)
# MCP_SERVER_URL=http://localhost:8080/mcp
# MCP_SERVER_URL_FOR_LANGCHAIN=http://localhost:8080/mcp
# MCP_TOOL_TIMEOUT=3600       # seconds; raise for multi-run PTM inference

# PTM inference model (defaults to INTERNAL_LLM_MODEL when empty)
# PTM_INFERENCE_MODEL=

# ── NCBI BLAST (required only for BLAST tools) ──────────────────────────────
# NCBI_EMAIL=your_email@example.com
# NCBI_APP_NAME=PTMdiscoverer_ADEPT

# ── Other LLM providers (all optional) ──────────────────────────────────────
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=
# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=
# GROQ_API_KEY=
# OLLAMA_API_BASE=http://host.docker.internal:11434
